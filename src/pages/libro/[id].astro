---
// import '../../styles/global.css';
import { getCollection, render } from "astro:content";
import { SHOW_BUY_BUTTON } from "astro:env/server";
import Layout from "../../layouts/Layout.astro";
import BookScore from "../../components/BookScore.astro";
import BuyButton from "../../components/BuyButton.astro";

export async function getStaticPaths() {
  const books = await getCollection("books");

  return books.map( (book) => ({
    params: { id:book.id },
    props: { book }
  }))
}

const { book } = Astro.props
const { data, id } = book
const { title, author, img, readtime, description, buy } = data

const { Content } = await render(book)

//De esta forma le decimos al servidor que queremos que esta página siga siendo estática:
export const prerender = true
---

<Layout title={`${title} - Books`}>
  <div class="flex flex-col md:flex-row gap-8 md:gap-10">
    <aside class="flex flex-col items-center gap-4 shrink-0">
      <a href="/" class="self-start md:self-center hover:underline opacity-70">Volver atrás</a>
      <img
        transition:name={`img-${id}`}
        class="rounded w-48 md:w-60 h-auto"
        src={`/${img}`} 
        alt={title}>
<!--Si queremos que esta parte "BookScore" sea dinámica tenemos que agregar server:defer
    y tenemos que cambiar la configuración en Astro.config.mjs-->
<!--Lo único que queremos que no sea estático es este componente, esta parte de nuestra página,
    así usamos islas de servidor -->
<!--El slot "fallback" se muestra mientras llega la isla de servidor. Le damos el mismo
    tamaño que el contenido final para que la página no "salte" al cargar los datos -->
      <BookScore server:defer id={id}>
        <span slot="fallback" class="text-xs h-4 opacity-50 animate-pulse">
          ⭐ Puntuación: -/5
        </span>
      </BookScore>
       {
        SHOW_BUY_BUTTON && (
          <BuyButton server:defer buy={buy}>
            <div slot="fallback" class="h-8 w-64 rounded-2xl bg-gray-100/20 animate-pulse"></div>
          </BuyButton>
        )
       }
    </aside>

    <main class="max-w-3xl min-w-0">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">{title}</h1>
      <div class="prose prose-invert">
        <Content />
      </div>
    </main>
  </div>
</Layout>

